diff --git a/derp/derphttp/xdial_proxy_test.go b/derp/derphttp/xdial_proxy_test.go
new file mode 100644
index 0000000..190e68b
--- /dev/null
+++ b/derp/derphttp/xdial_proxy_test.go
@@ -0,0 +1,52 @@
+package derphttp
+
+import (
+	"context"
+	"errors"
+	M "github.com/sagernet/sing/common/metadata"
+	"github.com/sagernet/tailscale/net/netmon"
+	"github.com/sagernet/tailscale/tailcfg"
+	"github.com/sagernet/tailscale/util/eventbus"
+	"net"
+	"net/url"
+	"syscall"
+	"testing"
+)
+
+type scopedProxyDialer struct {
+	calls  int
+	denied error
+}
+
+func (d *scopedProxyDialer) DialContext(context.Context, string, M.Socksaddr) (net.Conn, error) {
+	d.calls++
+	return nil, d.denied
+}
+func (d *scopedProxyDialer) ListenPacket(context.Context, M.Socksaddr) (net.PacketConn, error) {
+	return nil, d.denied
+}
+func (d *scopedProxyDialer) XDialSocketControl(string, string, syscall.RawConn) error {
+	return d.denied
+}
+func (d *scopedProxyDialer) XDialInterfaceState() (*netmon.State, error) { return &netmon.State{}, nil }
+func TestXDialDERPProxyUsesScopedTransport(t *testing.T) {
+	bus := eventbus.New()
+	defer bus.Close()
+	logf := func(string, ...any) {}
+	dialer := &scopedProxyDialer{denied: errors.New("protected refusal")}
+	monitor, err := netmon.New(bus, logf, dialer)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer monitor.Close()
+	client := &Client{logf: logf, netMon: monitor}
+	for _, scheme := range []string{"http", "https"} {
+		proxy, _ := url.Parse(scheme + "://proxy.invalid:1")
+		if _, err = client.dialNodeUsingProxy(context.Background(), &tailcfg.DERPNode{HostName: "derp.invalid"}, proxy); !errors.Is(err, dialer.denied) {
+			t.Fatalf("%s bypassed protection: %v", scheme, err)
+		}
+	}
+	if dialer.calls != 2 {
+		t.Fatal("proxy paths did not use owning Line")
+	}
+}

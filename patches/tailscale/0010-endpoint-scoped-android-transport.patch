diff --git a/net/netns/xdial_scoped_test.go b/net/netns/xdial_scoped_test.go
new file mode 100644
index 0000000..beefdcd
--- /dev/null
+++ b/net/netns/xdial_scoped_test.go
@@ -0,0 +1,67 @@
+package netns
+
+import (
+	"context"
+	"errors"
+	M "github.com/sagernet/sing/common/metadata"
+	"github.com/sagernet/tailscale/net/netmon"
+	"github.com/sagernet/tailscale/util/eventbus"
+	"net"
+	"syscall"
+	"testing"
+)
+
+type scopedTestDialer struct {
+	name            string
+	denied          error
+	controls, dials int
+}
+
+func (d *scopedTestDialer) DialContext(context.Context, string, M.Socksaddr) (net.Conn, error) {
+	d.dials++
+	return nil, d.denied
+}
+func (d *scopedTestDialer) ListenPacket(context.Context, M.Socksaddr) (net.PacketConn, error) {
+	return nil, d.denied
+}
+func (d *scopedTestDialer) XDialSocketControl(_, _ string, raw syscall.RawConn) error {
+	if err := raw.Control(func(uintptr) { d.controls++ }); err != nil {
+		return err
+	}
+	return d.denied
+}
+func (d *scopedTestDialer) XDialInterfaceState() (*netmon.State, error) {
+	return &netmon.State{DefaultRouteInterface: d.name, Interface: map[string]netmon.Interface{}}, nil
+}
+func TestXDialEndpointScopedHooksSurviveOtherMonitorRetirement(t *testing.T) {
+	bus := eventbus.New()
+	defer bus.Close()
+	logf := func(string, ...any) {}
+	a := &scopedTestDialer{name: "a", denied: errors.New("a protected refusal")}
+	b := &scopedTestDialer{name: "b", denied: errors.New("b protected refusal")}
+	first, err := netmon.New(bus, logf, a)
+	if err != nil {
+		t.Fatal(err)
+	}
+	second, err := netmon.New(bus, logf, b)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer second.Close()
+	SetControlFunc(func(string, string, syscall.RawConn) error { return errors.New("wrong global hook") })
+	defer SetControlFunc(nil)
+	if first.InterfaceState().DefaultRouteInterface != "a" || second.InterfaceState().DefaultRouteInterface != "b" {
+		t.Fatal("endpoint network facts crossed")
+	}
+	first.Close()
+	SetControlFunc(nil)
+	if _, err = Listener(logf, second).ListenPacket(context.Background(), "udp4", "127.0.0.1:0"); !errors.Is(err, b.denied) {
+		t.Fatalf("protection bypassed after close: %v", err)
+	}
+	if b.controls != 1 || a.controls != 0 {
+		t.Fatal("wrong owner received socket")
+	}
+	if _, err = NewDialerAlwaysDirect(logf, second).DialContext(context.Background(), "tcp", "invalid.example:443"); !errors.Is(err, b.denied) || b.dials != 1 {
+		t.Fatal("raw direct dialer bypassed the scoped Line")
+	}
+}

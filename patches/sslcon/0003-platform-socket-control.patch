 func (store *SessionStore) Del([]byte) error {
 	return nil
 }
+
+// dialDTLS controls the UDP fd before its first packet. DTLS requires an
+// unconnected PacketConn; net.DialUDP cannot implement WriteTo semantics.
+func dialDTLS(network string, addr *net.UDPAddr, config *dtls.Config, control func(string, string, syscall.RawConn) error) (*dtls.Conn, error) {
+	listener := net.ListenConfig{Control: control}
+	packet, err := listener.ListenPacket(context.Background(), network, ":0")
+	if err != nil {
+		return nil, err
+	}
+	conn, err := dtls.Client(packet, addr, config)
+	if err != nil {
+		_ = packet.Close()
+		return nil, err
+	}
+	return conn, nil
+}

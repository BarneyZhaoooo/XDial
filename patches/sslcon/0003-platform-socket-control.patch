diff --git a/vpn/xdial_socket_test.go b/vpn/xdial_socket_test.go
new file mode 100644
index 0000000..0887742
--- /dev/null
+++ b/vpn/xdial_socket_test.go
@@ -0,0 +1,65 @@
+package vpn
+
+import (
+	"context"
+	"errors"
+	"github.com/pion/dtls/v3"
+	"net"
+	"syscall"
+	"testing"
+	"time"
+)
+
+func TestDTLSProtectionFailurePreventsPacket(t *testing.T) {
+	peer, err := net.ListenPacket("udp4", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer peer.Close()
+	denied := errors.New("protection denied")
+	calls := 0
+	conn, err := dialDTLS("udp4", peer.LocalAddr().(*net.UDPAddr), &dtls.Config{}, func(_, _ string, raw syscall.RawConn) error { calls++; return denied })
+	if !errors.Is(err, denied) || conn != nil || calls != 1 {
+		t.Fatalf("not fail closed: calls=%d err=%v", calls, err)
+	}
+	_ = peer.SetReadDeadline(time.Now().Add(30 * time.Millisecond))
+	buf := make([]byte, 1500)
+	if n, _, err := peer.ReadFrom(buf); err == nil || n != 0 {
+		t.Fatal("unprotected datagram escaped")
+	}
+}
+func TestDTLSProtectionBeforeRealHandshakePacket(t *testing.T) {
+	peer, err := net.ListenPacket("udp4", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer peer.Close()
+	calls := 0
+	conn, err := dialDTLS("udp4", peer.LocalAddr().(*net.UDPAddr), &dtls.Config{InsecureSkipVerify: true}, func(_, _ string, raw syscall.RawConn) error {
+		return raw.Control(func(fd uintptr) {
+			if fd == 0 {
+				t.Error("invalid descriptor")
+			}
+			calls++
+		})
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Close()
+	if calls != 1 {
+		t.Fatal("control did not run before DTLS client creation")
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 200*time.Millisecond)
+	defer cancel()
+	done := make(chan struct{})
+	go func() { _ = conn.HandshakeContext(ctx); close(done) }()
+	_ = peer.SetReadDeadline(time.Now().Add(time.Second))
+	buf := make([]byte, 1500)
+	n, _, err := peer.ReadFrom(buf)
+	if err != nil || n < 13 {
+		t.Fatalf("no real DTLS handshake packet: n=%d err=%v", n, err)
+	}
+	cancel()
+	<-done
+}

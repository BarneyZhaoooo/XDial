new file mode 100644
index 0000000..37cbc90
--- /dev/null
+++ b/auth/xdial_socket_test.go
@@ -0,0 +1,31 @@
+package auth
+
+import (
+	"errors"
+	"syscall"
+	"testing"
+)
+
+func TestTLSProtectionFailurePreventsConnect(t *testing.T) {
+	old := Prof
+	defer func() { Prof = old }()
+	denied := errors.New("protection denied")
+	count := 0
+	Prof = &Profile{DialHostWithPort: "127.0.0.1:1", SocketControl: func(_, _ string, raw syscall.RawConn) error {
+		if err := raw.Control(func(fd uintptr) {
+			if fd == 0 {
+				t.Error("invalid descriptor")
+			}
+			count++
+		}); err != nil {
+			return err
+		}
+		return denied
+	}}
+	if err := InitAuth(); !errors.Is(err, denied) {
+		t.Fatalf("protection error not preserved: %v", err)
+	}
+	if count != 1 {
+		t.Fatalf("control calls %d", count)
+	}
+}

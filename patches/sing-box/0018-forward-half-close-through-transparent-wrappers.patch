+package route
+
+import (
+	"net"
+
+	N "github.com/sagernet/sing/common/network"
+)
+
+// xdialWriteCloser finds the half-close of a connection behind wrappers that
+// add nothing to the byte stream: the connection manager's tracking wrapper on
+// every dialed connection, and the traffic counters and deferred handshake
+// replies on the inbound side. None of them forwards CloseWrite, so a clean EOF
+// used to close such a connection entirely, and an application that finished
+// sending and then waited for the answer lost it. Wrappers that frame or
+// encrypt the stream are not looked through: a FIN on the socket beneath them
+// is not the end of their stream.
+func xdialWriteCloser(conn net.Conn) (N.WriteCloser, bool) {
+	if writeCloser, isDuplex := conn.(N.WriteCloser); isDuplex {
+		return writeCloser, true
+	}
+	writer, _ := N.UnwrapCountWriter(conn, nil)
+	writeCloser, isDuplex := writer.(N.WriteCloser)
+	return writeCloser, isDuplex
+}

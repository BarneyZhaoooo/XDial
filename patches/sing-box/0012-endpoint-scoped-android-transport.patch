diff --git a/protocol/tailscale/xdial_android_transport.go b/protocol/tailscale/xdial_android_transport.go
new file mode 100644
index 0000000..9e9bb68
--- /dev/null
+++ b/protocol/tailscale/xdial_android_transport.go
@@ -0,0 +1,59 @@
+//go:build with_gvisor
+
+package tailscale
+
+import (
+	"fmt"
+	"github.com/sagernet/sing-box/adapter"
+	N "github.com/sagernet/sing/common/network"
+	"github.com/sagernet/tailscale/net/netmon"
+	"net"
+	"net/netip"
+	"syscall"
+)
+
+// Android owns one adapter per endpoint. NetMon/NetNS retain this instance, so
+// retiring another endpoint cannot remove or replace its protection or facts.
+type androidEndpointDialer struct {
+	N.Dialer
+	platform adapter.PlatformInterface
+	network  adapter.NetworkManager
+}
+
+func (d *androidEndpointDialer) XDialSocketControl(_, _ string, raw syscall.RawConn) error {
+	if d.platform == nil || !d.platform.UsePlatformAutoDetectInterfaceControl() {
+		return fmt.Errorf("Android socket protection unavailable")
+	}
+	var controlErr error
+	if err := raw.Control(func(fd uintptr) { controlErr = d.platform.AutoDetectInterfaceControl(int(fd)) }); err != nil {
+		return err
+	}
+	return controlErr
+}
+func (d *androidEndpointDialer) XDialInterfaceState() (*netmon.State, error) {
+	if d.platform == nil || d.network == nil {
+		return nil, fmt.Errorf("Android network facts unavailable")
+	}
+	interfaces, err := d.platform.NetworkInterfaces()
+	if err != nil {
+		return nil, err
+	}
+	state := &netmon.State{Interface: map[string]netmon.Interface{}, InterfaceIPs: map[string][]netip.Prefix{}}
+	if def := d.network.DefaultNetworkInterface(); def != nil {
+		state.DefaultRouteInterface = def.Name
+		state.IsExpensive = def.Expensive
+	}
+	for _, it := range interfaces {
+		addresses := make([]net.Addr, 0, len(it.Addresses))
+		for _, prefix := range it.Addresses {
+			addresses = append(addresses, &net.IPNet{IP: prefix.Addr().AsSlice(), Mask: net.CIDRMask(prefix.Bits(), prefix.Addr().BitLen())})
+			if it.Flags&net.FlagUp != 0 && !prefix.Addr().IsLoopback() && !prefix.Addr().IsLinkLocalUnicast() {
+				state.HaveV4 = state.HaveV4 || prefix.Addr().Is4()
+				state.HaveV6 = state.HaveV6 || prefix.Addr().Is6()
+			}
+		}
+		state.Interface[it.Name] = netmon.Interface{Interface: &net.Interface{Index: it.Index, MTU: it.MTU, Name: it.Name, Flags: it.Flags, HardwareAddr: it.HardwareAddr}, AltAddrs: addresses}
+		state.InterfaceIPs[it.Name] = append([]netip.Prefix(nil), it.Addresses...)
+	}
+	return state, nil
+}
diff --git a/protocol/tailscale/xdial_android_transport_test.go b/protocol/tailscale/xdial_android_transport_test.go
new file mode 100644
index 0000000..0017c38
--- /dev/null
+++ b/protocol/tailscale/xdial_android_transport_test.go
@@ -0,0 +1,49 @@
+//go:build with_gvisor
+
+package tailscale
+
+import (
+	"errors"
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing/common/control"
+	"net"
+	"net/netip"
+	"testing"
+)
+
+type androidTestPlatform struct {
+	adapter.PlatformInterface
+	denied error
+	calls  int
+}
+
+func (p *androidTestPlatform) UsePlatformAutoDetectInterfaceControl() bool { return true }
+func (p *androidTestPlatform) AutoDetectInterfaceControl(int) error        { p.calls++; return p.denied }
+func (p *androidTestPlatform) NetworkInterfaces() ([]adapter.NetworkInterface, error) {
+	return []adapter.NetworkInterface{{Interface: control.Interface{Name: "os-underlay", Index: 77, MTU: 1400, Flags: net.FlagUp, Addresses: []netip.Prefix{netip.MustParsePrefix("192.0.2.4/24")}}}}, nil
+}
+
+type androidTestNetwork struct{ adapter.NetworkManager }
+
+func (n *androidTestNetwork) DefaultNetworkInterface() *adapter.NetworkInterface {
+	return &adapter.NetworkInterface{Interface: control.Interface{Name: "os-underlay"}, Expensive: true}
+}
+func TestXDialAndroidTransportUsesOnlyOwnedFactsAndProtection(t *testing.T) {
+	p := &androidTestPlatform{denied: errors.New("denied")}
+	d := &androidEndpointDialer{platform: p, network: &androidTestNetwork{}}
+	state, err := d.XDialInterfaceState()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if state.DefaultRouteInterface != "os-underlay" || !state.HaveV4 || state.HaveV6 || !state.IsExpensive || state.Interface["os-underlay"].Index != 77 {
+		t.Fatal("OS facts lost")
+	}
+	listener := net.ListenConfig{Control: d.XDialSocketControl}
+	if _, err = listener.ListenPacket(t.Context(), "udp4", "127.0.0.1:0"); !errors.Is(err, p.denied) || p.calls != 1 {
+		t.Fatal("socket refusal not propagated", err)
+	}
+	d.platform = nil
+	if _, err = listener.ListenPacket(t.Context(), "udp4", "127.0.0.1:0"); err == nil {
+		t.Fatal("missing protection allowed socket")
+	}
+}

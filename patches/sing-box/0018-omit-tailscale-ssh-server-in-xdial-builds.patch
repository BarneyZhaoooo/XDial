diff --git a/protocol/tailscale/tailssh/server_omitted.go b/protocol/tailscale/tailssh/server_omitted.go
new file mode 100644
index 0000000..249a0fb
--- /dev/null
+++ b/protocol/tailscale/tailssh/server_omitted.go
@@ -0,0 +1,37 @@
+//go:build with_gvisor && xdial_omit_tailssh
+
+// XDial builds without the Tailscale SSH server (xdial_omit_tailssh): it never
+// enables it, and leaving it out keeps the SFTP server's disk-space API out of
+// the Apple binaries, which would otherwise need a privacy-manifest reason.
+package tailssh
+
+import (
+	"context"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/option"
+	E "github.com/sagernet/sing/common/exceptions"
+	"github.com/sagernet/sing/common/logger"
+	tsDNS "github.com/sagernet/tailscale/net/dns"
+	"github.com/sagernet/tailscale/tsnet"
+	"github.com/sagernet/tailscale/wgengine/router"
+	"github.com/sagernet/tailscale/wgengine/wgcfg"
+)
+
+var errOmitted = E.New("Tailscale SSH server is not included in this build")
+
+type Server struct{}
+
+func CheckServerSupport(platformInterface adapter.PlatformInterface) (string, error) {
+	return "", errOmitted
+}
+
+func New(ctx context.Context, tsnetServer *tsnet.Server, platformInterface adapter.PlatformInterface, options *option.TailscaleSSHServerOptions, logger logger.ContextLogger) (*Server, error) {
+	return nil, errOmitted
+}
+
+func (s *Server) Start() error { return errOmitted }
+
+func (s *Server) Close() error { return nil }
+
+func (s *Server) OnReconfig(cfg *wgcfg.Config, routerCfg *router.Config, dnsCfg *tsDNS.Config) {}

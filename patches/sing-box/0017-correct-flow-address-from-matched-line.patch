@@ -0,0 +1,206 @@
+package route
+
+import (
+	"context"
+	"errors"
+	"net/netip"
+	"testing"
+
+	"github.com/sagernet/sing-box/adapter"
+	C "github.com/sagernet/sing-box/constant"
+	"github.com/sagernet/sing-box/log"
+	R "github.com/sagernet/sing-box/route/rule"
+	M "github.com/sagernet/sing/common/metadata"
+
+	"github.com/stretchr/testify/require"
+)
+
+type xdialCorrectionDNSRouter struct {
+	adapter.DNSRouter
+	addresses []netip.Addr
+	err       error
+	calls     int
+	domain    string
+}
+
+func (r *xdialCorrectionDNSRouter) Lookup(
+	_ context.Context,
+	domain string,
+	_ adapter.DNSQueryOptions,
+) ([]netip.Addr, error) {
+	r.calls++
+	r.domain = domain
+	return r.addresses, r.err
+}
+
+func xdialCorrectionRouter(resolver adapter.DNSRouter) *Router {
+	return &Router{
+		dns:    resolver,
+		logger: log.NewNOPFactory().NewLogger("router"),
+	}
+}
+
+func xdialSniffedTLSFlow(address string, domain string) *adapter.InboundContext {
+	return &adapter.InboundContext{
+		Destination: M.SocksaddrFrom(netip.MustParseAddr(address), 443),
+		Protocol:    C.ProtocolTLS,
+		Domain:      domain,
+		IPVersion:   4,
+	}
+}
+
+var xdialCorrectAction = &R.RuleActionResolve{XDialCorrectFlowAddress: true}
+
+// The incident shape: the application obtained a forged answer outside
+// XDial, connected by address, and presented the real name in TLS. The Line
+// selected for that name must connect to its own answer instead.
+func TestXDialCorrectionReplacesAddressOutsideLineAnswer(t *testing.T) {
+	lineAnswer := []netip.Addr{
+		netip.MustParseAddr("104.18.32.47"),
+		netip.MustParseAddr("172.64.155.209"),
+	}
+	resolver := &xdialCorrectionDNSRouter{addresses: lineAnswer}
+	metadata := xdialSniffedTLSFlow("108.160.162.104", "chatgpt.com")
+	original := metadata.Destination
+
+	err := xdialCorrectionRouter(resolver).actionResolve(
+		context.Background(), metadata, xdialCorrectAction,
+	)
+
+	require.NoError(t, err)
+	require.Equal(t, "chatgpt.com", resolver.domain)
+	require.True(t, metadata.XDialCorrectedFlowAddress)
+	require.Equal(t, "chatgpt.com", metadata.Destination.Fqdn)
+	require.Equal(t, uint16(443), metadata.Destination.Port)
+	require.Equal(t, original, metadata.RouteOriginalDestination)
+	require.Equal(t, lineAnswer, metadata.DestinationAddresses)
+	require.Zero(t, metadata.IPVersion)
+}
+
+func TestXDialCorrectionKeepsAddressInsideLineAnswer(t *testing.T) {
+	resolver := &xdialCorrectionDNSRouter{addresses: []netip.Addr{
+		netip.MustParseAddr("104.18.32.47"),
+	}}
+	metadata := xdialSniffedTLSFlow("104.18.32.47", "chatgpt.com")
+	before := *metadata
+
+	err := xdialCorrectionRouter(resolver).actionResolve(
+		context.Background(), metadata, xdialCorrectAction,
+	)
+
+	require.NoError(t, err)
+	require.Equal(t, 1, resolver.calls)
+	require.Equal(t, before, *metadata)
+}
+
+func TestXDialCorrectionKeepsAddressWhenLineCannotAnswer(t *testing.T) {
+	for name, resolver := range map[string]*xdialCorrectionDNSRouter{
+		"error": {err: errors.New("line resolver unavailable")},
+		"empty": {},
+	} {
+		t.Run(name, func(t *testing.T) {
+			metadata := xdialSniffedTLSFlow("108.160.162.104", "chatgpt.com")
+			before := *metadata
+
+			err := xdialCorrectionRouter(resolver).actionResolve(
+				context.Background(), metadata, xdialCorrectAction,
+			)
+
+			require.NoError(t, err)
+			require.Equal(t, before, *metadata)
+		})
+	}
+}
+
+func TestXDialCorrectionRequiresExplicitRuleOption(t *testing.T) {
+	resolver := &xdialCorrectionDNSRouter{addresses: []netip.Addr{
+		netip.MustParseAddr("104.18.32.47"),
+	}}
+	metadata := xdialSniffedTLSFlow("108.160.162.104", "chatgpt.com")
+	before := *metadata
+
+	err := xdialCorrectionRouter(resolver).actionResolve(
+		context.Background(), metadata, &R.RuleActionResolve{},
+	)
+
+	require.NoError(t, err)
+	require.Zero(t, resolver.calls)
+	require.Equal(t, before, *metadata)
+}
+
+func TestXDialCorrectionUsesSystemHostnameWhenItAgreesWithSniff(t *testing.T) {
+	resolver := &xdialCorrectionDNSRouter{addresses: []netip.Addr{
+		netip.MustParseAddr("104.18.32.47"),
+	}}
+	metadata := xdialSniffedTLSFlow("108.160.162.104", "ChatGPT.com.")
+	metadata.XDialOriginalDestinationDomain = "chatgpt.com"
+
+	err := xdialCorrectionRouter(resolver).actionResolve(
+		context.Background(), metadata, xdialCorrectAction,
+	)
+
+	require.NoError(t, err)
+	require.Equal(t, "chatgpt.com", resolver.domain)
+	require.True(t, metadata.XDialCorrectedFlowAddress)
+}
+
+func TestXDialFlowDomainForAddressCorrection(t *testing.T) {
+	tests := []struct {
+		name     string
+		address  string
+		protocol string
+		domain   string
+		trusted  string
+		sniffErr error
+		want     string
+	}{
+		{"tls", "108.160.162.104", C.ProtocolTLS, "chatgpt.com", "", nil, "chatgpt.com"},
+		{"quic", "108.160.162.104", C.ProtocolQUIC, "chatgpt.com", "", nil, "chatgpt.com"},
+		{"http", "108.160.162.104", C.ProtocolHTTP, "chatgpt.com", "", nil, "chatgpt.com"},
+		{"system-hostname-without-sniff", "108.160.162.104", "", "chatgpt.com", "chatgpt.com", nil, "chatgpt.com"},
+		{"system-hostname-disagrees", "108.160.162.104", C.ProtocolTLS, "front.example", "chatgpt.com", nil, ""},
+		{"unsniffed-name", "108.160.162.104", "", "chatgpt.com", "", nil, ""},
+		{"other-protocol", "108.160.162.104", C.ProtocolSSH, "chatgpt.com", "", nil, ""},
+		{"sniff-error", "108.160.162.104", C.ProtocolTLS, "chatgpt.com", "", errors.New("partial"), ""},
+		{"no-name", "108.160.162.104", C.ProtocolTLS, "", "", nil, ""},
+		{"literal-host", "108.160.162.104", C.ProtocolHTTP, "104.18.32.47", "", nil, ""},
+		{"private", "192.168.1.20", C.ProtocolTLS, "chatgpt.com", "", nil, ""},
+		{"loopback", "127.0.0.1", C.ProtocolTLS, "chatgpt.com", "", nil, ""},
+		{"link-local", "169.254.10.1", C.ProtocolTLS, "chatgpt.com", "", nil, ""},
+		{"shared-address-space", "100.101.102.103", C.ProtocolTLS, "node.example.ts.net", "", nil, ""},
+		{"reserved-tunnel-range", "198.18.0.10", C.ProtocolTLS, "chatgpt.com", "", nil, ""},
+		{"unique-local-ipv6", "fd7a:115c:a1e0::1", C.ProtocolTLS, "chatgpt.com", "", nil, ""},
+		{"public-ipv6", "2606:4700::6812:2001", C.ProtocolTLS, "chatgpt.com", "", nil, "chatgpt.com"},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			metadata := &adapter.InboundContext{
+				Destination:                    M.SocksaddrFrom(netip.MustParseAddr(test.address), 443),
+				Protocol:                       test.protocol,
+				Domain:                         test.domain,
+				XDialOriginalDestinationDomain: test.trusted,
+				SniffError:                     test.sniffErr,
+			}
+			require.Equal(t, test.want, xdialFlowDomainForAddressCorrection(metadata))
+		})
+	}
+
+	domainDestination := &adapter.InboundContext{
+		Destination: M.Socksaddr{Fqdn: "chatgpt.com", Port: 443},
+		Protocol:    C.ProtocolTLS,
+		Domain:      "chatgpt.com",
+	}
+	require.Empty(t, xdialFlowDomainForAddressCorrection(domainDestination))
+}
+
+func TestXDialFlowAddressNeedsCorrectionComparesUnmappedAddresses(t *testing.T) {
+	mapped := netip.MustParseAddr("::ffff:104.18.32.47")
+	answer := []netip.Addr{netip.MustParseAddr("104.18.32.47")}
+
+	require.False(t, xdialFlowAddressNeedsCorrection(mapped, answer))
+	require.True(t, xdialFlowAddressNeedsCorrection(
+		netip.MustParseAddr("108.160.162.104"),
+		answer,
+	))
+	require.False(t, xdialFlowAddressNeedsCorrection(mapped, nil))
+}

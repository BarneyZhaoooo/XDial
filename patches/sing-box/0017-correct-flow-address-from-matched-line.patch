+// xdialFlowDomainForAddressCorrection returns the name whose owning Line may
+// verify an application-supplied endpoint. The name must be the one this flow
+// was matched with: a hostname reported by the system for the flow, or, when
+// the application connected by address, the name it presented in TLS, QUIC or
+// HTTP. A system hostname that disagrees with the sniffed name is ambiguous
+// and is left alone. Non-public endpoints are deliberate local, private or
+// overlay choices and are never replaced.
+func xdialFlowDomainForAddressCorrection(metadata *adapter.InboundContext) string {
+	if !metadata.Destination.IsIP() ||
+		!xdialCorrectableFlowAddress(metadata.Destination.Addr) {
+		return ""
+	}
+	domain := xdialCanonicalFlowDomain(metadata.Domain)
+	if domain == "" {
+		return ""
+	}
+	if trusted := metadata.XDialOriginalDestinationDomain; trusted != "" {
+		if xdialCanonicalFlowDomain(trusted) != domain {
+			return ""
+		}
+		return trusted
+	}
+	if metadata.SniffError != nil {
+		return ""
+	}
+	switch metadata.Protocol {
+	case C.ProtocolTLS, C.ProtocolQUIC, C.ProtocolHTTP:
+		return metadata.Domain
+	default:
+		return ""
+	}
+}
+
+func xdialCanonicalFlowDomain(raw string) string {
+	domain := strings.ToLower(strings.TrimSuffix(raw, "."))
+	if domain == "" || !M.IsDomainName(domain) {
+		return ""
+	}
+	if _, err := netip.ParseAddr(domain); err == nil {
+		return ""
+	}
+	return domain
+}
+
+// Shared address space carries carrier NAT and Tailscale overlay addresses;
+// 198.18.0.0/15 is reserved for tunnel and synthetic-address use.
+var xdialNonPublicFlowPrefixes = []netip.Prefix{
+	netip.MustParsePrefix("100.64.0.0/10"),
+	netip.MustParsePrefix("198.18.0.0/15"),
+}
+
+func xdialCorrectableFlowAddress(address netip.Addr) bool {
+	address = address.Unmap()
+	if !address.IsValid() || address.Zone() != "" ||
+		!address.IsGlobalUnicast() || address.IsPrivate() {
+		return false
+	}
+	for _, prefix := range xdialNonPublicFlowPrefixes {
+		if prefix.Contains(address) {
+			return false
+		}
+	}
+	return true
+}
+
+func xdialFlowAddressNeedsCorrection(
+	destination netip.Addr,
+	addresses []netip.Addr,
+) bool {
+	if len(addresses) == 0 {
+		return false
+	}
+	destination = destination.Unmap()
+	for _, address := range addresses {
+		if address.Unmap() == destination {
+			return false
+		}
+	}
+	return true
+}

+package route
+
+import (
+	"context"
+	"errors"
+	"io"
+	"net"
+	"os"
+	"strings"
+	"syscall"
+
+	"github.com/sagernet/sing/common"
+)
+
+// A relayed TCP connection has two ways to end. A clean EOF is forwarded as a
+// half-close, so the application sees the end of the stream. Any other end
+// means the stream was cut, and a graceful close of the inbound connection
+// would tell the application that the peer finished normally. For those the
+// inbound connection is closed with SO_LINGER 0, which sends a reset.
+//
+// Errors raised by the inbound connection itself keep the ordinary close: the
+// application (or whatever sits in front of the inbound) already ended that
+// connection, so there is nobody left to inform.
+
+// xdialCloseFailedRelay closes both ends after one relay direction stopped
+// with err. It reports whether the upstream side caused the failure, in which
+// case the inbound connection was reset instead of closed gracefully.
+func xdialCloseFailedRelay(source net.Conn, destination net.Conn, download bool, err error) bool {
+	inbound, upstream := source, destination
+	if download {
+		inbound, upstream = destination, source
+	}
+	if xdialRelayErrorFromInbound(err, inbound, download) {
+		common.Close(source, destination)
+		return false
+	}
+	xdialResetConn(inbound)
+	common.Close(upstream)
+	return true
+}
+
+// xdialCloseAfterFailedHalfClose closes both ends after forwarding a clean EOF
+// to destination failed. sing's copy reports a failed first write as a clean
+// end, so a destination that was already dead surfaces here. The failing
+// connection is known: it is the upstream exactly when relaying the upload
+// direction, where the application is still waiting for an answer.
+func xdialCloseAfterFailedHalfClose(source net.Conn, destination net.Conn, download bool) bool {
+	if download {
+		common.Close(source, destination)
+		return false
+	}
+	xdialResetConn(source)
+	common.Close(destination)
+	return true
+}
+
+// xdialResetConn closes conn abortively when it is backed by a TCP socket.
+// Other connection types have no reset to send and are closed normally.
+func xdialResetConn(conn net.Conn) {
+	if lingerConn, loaded := common.Cast[interface {
+		SetLinger(sec int) error
+	}](conn); loaded {
+		// Fails on a socket the peer already reset; nothing is left to signal.
+		_ = lingerConn.SetLinger(0)
+	}
+	_ = conn.Close()
+}
+
+// xdialRelayErrorFromInbound reports whether err was raised by an operation on
+// the inbound connection: a write to it while relaying the download direction,
+// or a read from it while relaying the upload direction. Anything that cannot
+// be attributed to the inbound connection counts as an upstream failure.
+// Resetting an inbound connection that already failed is harmless, so the
+// uncertain cases err on the side that keeps the application informed.
+func xdialRelayErrorFromInbound(err error, inbound net.Conn, download bool) bool {
+	var opErr *net.OpError
+	if errors.As(err, &opErr) {
+		if !xdialOpErrorOnConn(opErr, inbound) {
+			return false
+		}
+		if download {
+			return strings.Contains(opErr.Op, "write")
+		}
+		return strings.Contains(opErr.Op, "read")
+	}
+	if download {
+		// sing's vectorised writer reports a failed writev without addresses.
+		var syscallErr *os.SyscallError
+		return errors.As(err, &syscallErr) &&
+			strings.Contains(strings.ToLower(syscallErr.Syscall), "write")
+	}
+	// sing's raw read waiter reports the source errno without addresses.
+	return strings.HasPrefix(err.Error(), "raw read: ")
+}
+
+// xdialOpErrorOnConn reports whether opErr names conn's socket. Inbound
+// wrappers may present other addresses than the socket they sit on, so every
+// layer down to the socket is compared.
+func xdialOpErrorOnConn(opErr *net.OpError, conn net.Conn) bool {
+	if opErr.Source == nil || opErr.Addr == nil {
+		return false
+	}
+	for layer := any(conn); layer != nil; {
+		if layerConn, isConn := layer.(net.Conn); isConn {
+			localAddr, remoteAddr := layerConn.LocalAddr(), layerConn.RemoteAddr()
+			if localAddr != nil && remoteAddr != nil &&
+				opErr.Source.String() == localAddr.String() &&
+				opErr.Addr.String() == remoteAddr.String() {
+				return true
+			}
+		}
+		withUpstream, hasUpstream := layer.(common.WithUpstream)
+		if !hasUpstream {
+			return false
+		}
+		layer = withUpstream.Upstream()
+	}
+	return false
+}
+
+// xdialRelayClosedLocally reports whether err only says that this process
+// closed the connection, as opposed to a failure reported by the network.
+func xdialRelayClosedLocally(err error) bool {
+	return errors.Is(err, net.ErrClosed) ||
+		errors.Is(err, os.ErrClosed) ||
+		errors.Is(err, io.ErrClosedPipe) ||
+		errors.Is(err, context.Canceled)
+}
+
+// xdialRelayErrorReason names the failure without addresses or host names, so
+// the line stays useful after a log sink redacts network identifiers.
+func xdialRelayErrorReason(err error) string {
+	var errno syscall.Errno
+	if errors.As(err, &errno) {
+		switch errno {
+		case syscall.ECONNRESET:
+			return "reset"
+		case syscall.ETIMEDOUT:
+			return "timeout"
+		case syscall.EPIPE:
+			return "broken-pipe"
+		case syscall.ECONNABORTED:
+			return "aborted"
+		case syscall.ENETDOWN, syscall.ENETUNREACH, syscall.EHOSTDOWN, syscall.EHOSTUNREACH:
+			return "unreachable"
+		}
+		return "errno-" + strings.ToLower(strings.ReplaceAll(errno.Error(), " ", "-"))
+	}
+	var netErr net.Error
+	if errors.As(err, &netErr) && netErr.Timeout() {
+		return "timeout"
+	}
+	if errors.Is(err, io.ErrUnexpectedEOF) {
+		return "truncated"
+	}
+	return "error"
+}

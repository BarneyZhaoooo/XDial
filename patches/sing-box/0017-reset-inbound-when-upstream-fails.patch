+package route
+
+import (
+	"context"
+	"errors"
+	"io"
+	"net"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"syscall"
+	"testing"
+	"time"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/log"
+	"github.com/sagernet/sing/common/bufio"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+
+	"github.com/stretchr/testify/require"
+)
+
+const xdialRelayTestTimeout = 5 * time.Second
+
+// xdialRelayFixture is one application connection relayed by the connection
+// manager to one origin server, all over loopback TCP.
+type xdialRelayFixture struct {
+	application *net.TCPConn
+	origin      *net.TCPConn
+	logs        *xdialRelayLogWriter
+}
+
+type xdialRelayLogWriter struct {
+	access   sync.Mutex
+	messages []string
+	levels   []log.Level
+}
+
+func (w *xdialRelayLogWriter) WriteMessage(level log.Level, message string) {
+	w.access.Lock()
+	defer w.access.Unlock()
+	w.levels = append(w.levels, level)
+	w.messages = append(w.messages, message)
+}
+
+func (w *xdialRelayLogWriter) warnings() []string {
+	w.access.Lock()
+	defer w.access.Unlock()
+	var warnings []string
+	for index, level := range w.levels {
+		if level <= log.LevelWarn {
+			warnings = append(warnings, w.messages[index])
+		}
+	}
+	return warnings
+}
+
+func xdialAcceptTCP(t *testing.T, listener net.Listener) *net.TCPConn {
+	t.Helper()
+	_ = listener.(*net.TCPListener).SetDeadline(time.Now().Add(xdialRelayTestTimeout))
+	conn, err := listener.Accept()
+	require.NoError(t, err)
+	return conn.(*net.TCPConn)
+}
+
+func newXDialRelayFixture(t *testing.T) *xdialRelayFixture {
+	t.Helper()
+	inboundListener, err := net.Listen("tcp", "127.0.0.1:0")
+	require.NoError(t, err)
+	t.Cleanup(func() { inboundListener.Close() })
+	originListener, err := net.Listen("tcp", "127.0.0.1:0")
+	require.NoError(t, err)
+	t.Cleanup(func() { originListener.Close() })
+
+	application, err := net.Dial("tcp", inboundListener.Addr().String())
+	require.NoError(t, err)
+	t.Cleanup(func() { application.Close() })
+	inbound := xdialAcceptTCP(t, inboundListener)
+	t.Cleanup(func() { inbound.Close() })
+
+	logs := &xdialRelayLogWriter{}
+	logFactory := log.NewDefaultFactory(
+		context.Background(),
+		log.Formatter{DisableColors: true, DisableTimestamp: true},
+		io.Discard,
+		"",
+		logs,
+		false,
+	)
+	logFactory.SetLevel(log.LevelInfo)
+	manager := NewConnectionManager(logFactory.NewLogger("connection"))
+	ctx := log.ContextWithNewID(context.Background())
+	manager.NewConnection(
+		ctx,
+		N.SystemDialer,
+		inbound,
+		adapter.InboundContext{
+			Destination: M.SocksaddrFromNet(originListener.Addr()),
+		},
+		nil,
+	)
+	origin := xdialAcceptTCP(t, originListener)
+	t.Cleanup(func() { origin.Close() })
+
+	fixture := &xdialRelayFixture{
+		application: application.(*net.TCPConn),
+		origin:      origin,
+		logs:        logs,
+	}
+	// Prove the relay is up in both directions before a test disturbs it.
+	fixture.roundTrip(t)
+	return fixture
+}
+
+func (f *xdialRelayFixture) roundTrip(t *testing.T) {
+	t.Helper()
+	deadline := time.Now().Add(xdialRelayTestTimeout)
+	_ = f.application.SetDeadline(deadline)
+	_ = f.origin.SetDeadline(deadline)
+	buffer := make([]byte, 4)
+	_, err := f.application.Write([]byte("ping"))
+	require.NoError(t, err)
+	_, err = io.ReadFull(f.origin, buffer)
+	require.NoError(t, err)
+	require.Equal(t, "ping", string(buffer))
+	_, err = f.origin.Write([]byte("pong"))
+	require.NoError(t, err)
+	_, err = io.ReadFull(f.application, buffer)
+	require.NoError(t, err)
+	require.Equal(t, "pong", string(buffer))
+}
+
+func TestXDialRelayForwardsUpstreamResetAsReset(t *testing.T) {
+	fixture := newXDialRelayFixture(t)
+
+	require.NoError(t, fixture.origin.SetLinger(0))
+	require.NoError(t, fixture.origin.Close())
+
+	_, err := fixture.application.Read(make([]byte, 1))
+	require.ErrorIs(t, err, syscall.ECONNRESET,
+		"an upstream reset must not reach the application as a clean end of stream")
+
+	require.Eventually(t, func() bool {
+		for _, message := range fixture.logs.warnings() {
+			if containsAll(message, "interrupted by upstream", "reason=reset") {
+				return true
+			}
+		}
+		return false
+	}, xdialRelayTestTimeout, 10*time.Millisecond,
+		"the reset must be reported at warn level")
+}
+
+func TestXDialRelayKeepsUpstreamFinAsCleanEOF(t *testing.T) {
+	fixture := newXDialRelayFixture(t)
+
+	_, err := fixture.origin.Write([]byte("bye"))
+	require.NoError(t, err)
+	require.NoError(t, fixture.origin.CloseWrite())
+
+	received, err := io.ReadAll(fixture.application)
+	require.NoError(t, err, "an upstream FIN must stay a clean end of stream")
+	require.Equal(t, "bye", string(received))
+
+	// The half-close leaves the upload direction usable.
+	_, err = fixture.application.Write([]byte("late"))
+	require.NoError(t, err)
+	buffer := make([]byte, 4)
+	_, err = io.ReadFull(fixture.origin, buffer)
+	require.NoError(t, err)
+	require.Equal(t, "late", string(buffer))
+
+	require.NoError(t, fixture.application.CloseWrite())
+	_, err = fixture.origin.Read(buffer)
+	require.ErrorIs(t, err, io.EOF)
+	require.Empty(t, fixture.logs.warnings())
+}
+
+func TestXDialRelayKeepsApplicationHalfCloseClean(t *testing.T) {
+	fixture := newXDialRelayFixture(t)
+
+	// The application finishes sending first and still waits for the reply.
+	require.NoError(t, fixture.application.CloseWrite())
+	buffer := make([]byte, 1)
+	_, err := fixture.origin.Read(buffer)
+	require.ErrorIs(t, err, io.EOF)
+
+	_, err = fixture.origin.Write([]byte("reply"))
+	require.NoError(t, err)
+	require.NoError(t, fixture.origin.Close())
+
+	received, err := io.ReadAll(fixture.application)
+	require.NoError(t, err)
+	require.Equal(t, "reply", string(received))
+	require.Empty(t, fixture.logs.warnings())
+}
+
+func TestXDialRelayApplicationResetIsNotAnUpstreamFailure(t *testing.T) {
+	fixture := newXDialRelayFixture(t)
+
+	require.NoError(t, fixture.application.SetLinger(0))
+	require.NoError(t, fixture.application.Close())
+
+	// The origin sees the relay close its side; the test only needs the relay
+	// to finish, whichever way the kernel reports it.
+	_, _ = io.Copy(io.Discard, fixture.origin)
+	time.Sleep(50 * time.Millisecond)
+	require.Empty(t, fixture.logs.warnings(),
+		"a connection the application ended is not an upstream failure")
+}
+
+// sing's copy reports a failed first write as a clean end. When the upstream is
+// already dead as the application sends its first bytes, the failure only
+// shows when the relay forwards the supposed EOF.
+func TestXDialRelayResetsApplicationWhenFirstUploadWriteFails(t *testing.T) {
+	inboundListener, err := net.Listen("tcp", "127.0.0.1:0")
+	require.NoError(t, err)
+	defer inboundListener.Close()
+	originListener, err := net.Listen("tcp", "127.0.0.1:0")
+	require.NoError(t, err)
+	defer originListener.Close()
+
+	applicationConn, err := net.Dial("tcp", inboundListener.Addr().String())
+	require.NoError(t, err)
+	application := applicationConn.(*net.TCPConn)
+	defer application.Close()
+	inbound := xdialAcceptTCP(t, inboundListener)
+	defer inbound.Close()
+	upstream, err := net.Dial("tcp", originListener.Addr().String())
+	require.NoError(t, err)
+	defer upstream.Close()
+	origin := xdialAcceptTCP(t, originListener)
+
+	require.NoError(t, origin.SetLinger(0))
+	require.NoError(t, origin.Close())
+	// Consume the reset so only the upload direction can notice the dead upstream.
+	_ = upstream.SetReadDeadline(time.Now().Add(xdialRelayTestTimeout))
+	_, err = upstream.Read(make([]byte, 1))
+	require.ErrorIs(t, err, syscall.ECONNRESET)
+
+	manager := NewConnectionManager(log.NewNOPFactory().NewLogger("connection"))
+	var done atomic.Bool
+	go manager.connectionCopy(context.Background(), inbound, upstream, false, &done, nil)
+
+	_, err = application.Write([]byte("request"))
+	require.NoError(t, err)
+	_ = application.SetReadDeadline(time.Now().Add(xdialRelayTestTimeout))
+	_, err = application.Read(make([]byte, 1))
+	require.ErrorIs(t, err, syscall.ECONNRESET)
+}
+
+// The attribution reads error shapes produced by sing's copy paths. These cases
+// run the real copy over real sockets so a changed shape fails here first.
+func TestXDialRelayErrorAttribution(t *testing.T) {
+	newPair := func(t *testing.T) (dialed *net.TCPConn, accepted *net.TCPConn) {
+		t.Helper()
+		listener, err := net.Listen("tcp", "127.0.0.1:0")
+		require.NoError(t, err)
+		defer listener.Close()
+		conn, err := net.Dial("tcp", listener.Addr().String())
+		require.NoError(t, err)
+		t.Cleanup(func() { conn.Close() })
+		accepted = xdialAcceptTCP(t, listener)
+		t.Cleanup(func() { accepted.Close() })
+		return conn.(*net.TCPConn), accepted
+	}
+	reset := func(t *testing.T, conn *net.TCPConn) {
+		t.Helper()
+		require.NoError(t, conn.SetLinger(0))
+		require.NoError(t, conn.Close())
+	}
+	// Keeps data flowing so the copy is past its first write when the far end
+	// goes away: sing reports a failed first write as a clean end.
+	feed := func(conn *net.TCPConn) {
+		payload := make([]byte, 16*1024)
+		for {
+			if _, err := conn.Write(payload); err != nil {
+				return
+			}
+		}
+	}
+	drainThenReset := func(t *testing.T, conn *net.TCPConn) {
+		t.Helper()
+		_ = conn.SetReadDeadline(time.Now().Add(xdialRelayTestTimeout))
+		_, err := io.ReadFull(conn, make([]byte, 64*1024))
+		require.NoError(t, err)
+		reset(t, conn)
+	}
+	copyResult := func(destination net.Conn, source net.Conn) <-chan error {
+		result := make(chan error, 1)
+		go func() {
+			_, err := bufio.Copy(destination, source)
+			result <- err
+		}()
+		return result
+	}
+	await := func(t *testing.T, result <-chan error) error {
+		t.Helper()
+		select {
+		case err := <-result:
+			return err
+		case <-time.After(xdialRelayTestTimeout):
+			t.Fatal("copy did not finish")
+			return nil
+		}
+	}
+
+	t.Run("download/upstream-read", func(t *testing.T) {
+		_, inbound := newPair(t)
+		upstream, origin := newPair(t)
+		reset(t, origin)
+		err := await(t, copyResult(inbound, upstream))
+		require.Error(t, err)
+		require.False(t, xdialRelayErrorFromInbound(err, inbound, true), "%v", err)
+		require.Equal(t, "reset", xdialRelayErrorReason(err))
+	})
+	t.Run("download/inbound-write", func(t *testing.T) {
+		application, inbound := newPair(t)
+		upstream, origin := newPair(t)
+		result := copyResult(inbound, upstream)
+		go feed(origin)
+		drainThenReset(t, application)
+		err := await(t, result)
+		require.Error(t, err)
+		require.True(t, xdialRelayErrorFromInbound(err, inbound, true), "%v", err)
+	})
+	t.Run("upload/inbound-read", func(t *testing.T) {
+		application, inbound := newPair(t)
+		upstream, _ := newPair(t)
+		reset(t, application)
+		err := await(t, copyResult(upstream, inbound))
+		require.Error(t, err)
+		require.True(t, xdialRelayErrorFromInbound(err, inbound, false), "%v", err)
+	})
+	t.Run("upload/upstream-write", func(t *testing.T) {
+		application, inbound := newPair(t)
+		upstream, origin := newPair(t)
+		result := copyResult(upstream, inbound)
+		go feed(application)
+		drainThenReset(t, origin)
+		err := await(t, result)
+		require.Error(t, err)
+		require.False(t, xdialRelayErrorFromInbound(err, inbound, false), "%v", err)
+	})
+	t.Run("download/inbound-write-through-readdressed-wrapper", func(t *testing.T) {
+		application, inbound := newPair(t)
+		upstream, origin := newPair(t)
+		wrapped := &xdialReaddressedConn{Conn: inbound}
+		result := copyResult(wrapped, upstream)
+		go feed(origin)
+		drainThenReset(t, application)
+		err := await(t, result)
+		require.Error(t, err)
+		require.True(t, xdialRelayErrorFromInbound(err, wrapped, true), "%v", err)
+	})
+	t.Run("upstream-closed-locally", func(t *testing.T) {
+		_, inbound := newPair(t)
+		upstream, _ := newPair(t)
+		require.NoError(t, upstream.Close())
+		_, err := bufio.Copy(inbound, upstream)
+		require.Error(t, err)
+		require.False(t, xdialRelayErrorFromInbound(err, inbound, true), "%v", err)
+		require.True(t, xdialRelayClosedLocally(err), "%v", err)
+	})
+	t.Run("unattributed", func(t *testing.T) {
+		_, inbound := newPair(t)
+		err := errors.New("protocol stream reset")
+		require.False(t, xdialRelayErrorFromInbound(err, inbound, true))
+		require.False(t, xdialRelayErrorFromInbound(err, inbound, false))
+		require.Equal(t, "error", xdialRelayErrorReason(err))
+		require.Equal(t, "truncated", xdialRelayErrorReason(io.ErrUnexpectedEOF))
+	})
+}
+
+// xdialReaddressedConn stands for an inbound wrapper that reports the
+// application's address instead of the loopback socket's.
+type xdialReaddressedConn struct {
+	net.Conn
+}
+
+func (c *xdialReaddressedConn) RemoteAddr() net.Addr {
+	return &net.TCPAddr{IP: net.IPv4(192, 0, 2, 1), Port: 1}
+}
+
+func (c *xdialReaddressedConn) Upstream() any {
+	return c.Conn
+}
+
+func containsAll(message string, parts ...string) bool {
+	for _, part := range parts {
+		if !strings.Contains(message, part) {
+			return false
+		}
+	}
+	return true
+}

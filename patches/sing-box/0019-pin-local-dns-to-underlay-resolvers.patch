@@ -0,0 +1,49 @@
+package local
+
+import (
+	"net"
+	"net/netip"
+	"strings"
+	"time"
+
+	E "github.com/sagernet/sing/common/exceptions"
+)
+
+// XDial pins a local transport to an explicit resolver list. The macOS
+// Transparent Proxy must resolve Direct names through the pre-start Underlay
+// resolvers: /etc/resolv.conf and the application's own resolver address can
+// belong to a virtual network (for example Tailscale MagicDNS) that the
+// current data plane does not carry. Each server is tried in order with the
+// same sequential retry the system resolv.conf path uses, so a secondary
+// Underlay resolver still answers when the first one is unreachable.
+const (
+	xdialFixedDNSTimeout  = 2 * time.Second
+	xdialFixedDNSAttempts = 2
+)
+
+func newXDialFixedDNSConfig(rawServers []string) (*dnsConfig, error) {
+	if len(rawServers) == 0 {
+		return nil, nil
+	}
+	seen := make(map[netip.Addr]bool, len(rawServers))
+	servers := make([]string, 0, len(rawServers))
+	for _, raw := range rawServers {
+		address, err := netip.ParseAddr(strings.TrimSpace(raw))
+		if err != nil || address.IsUnspecified() || address.IsMulticast() {
+			return nil, E.New("invalid xdial_servers address: ", raw)
+		}
+		address = address.Unmap()
+		if seen[address] {
+			continue
+		}
+		seen[address] = true
+		servers = append(servers, net.JoinHostPort(address.String(), "53"))
+	}
+	return &dnsConfig{
+		servers:  servers,
+		ndots:    1,
+		timeout:  xdialFixedDNSTimeout,
+		attempts: xdialFixedDNSAttempts,
+		noReload: true,
+	}, nil
+}

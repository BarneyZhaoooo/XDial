@@ -0,0 +1,36 @@
+package local
+
+import (
+	"reflect"
+	"testing"
+)
+
+func TestXDialFixedDNSConfigKeepsEveryUnderlayResolverInOrder(t *testing.T) {
+	config, err := newXDialFixedDNSConfig([]string{
+		"202.180.64.10", " 202.180.64.11 ", "202.180.64.10", "2001:db8::53",
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := []string{"202.180.64.10:53", "202.180.64.11:53", "[2001:db8::53]:53"}
+	if !reflect.DeepEqual(config.servers, want) {
+		t.Fatalf("servers = %v, want %v", config.servers, want)
+	}
+	if config.attempts < 1 || config.timeout <= 0 || len(config.search) != 0 {
+		t.Fatalf("unexpected retry policy: %+v", config)
+	}
+	if names := config.nameList("service.example."); !reflect.DeepEqual(names, []string{"service.example."}) {
+		t.Fatalf("fixed resolver must not expand search domains: %v", names)
+	}
+}
+
+func TestXDialFixedDNSConfigRejectsInvalidResolvers(t *testing.T) {
+	for _, raw := range []string{"resolver.example", "0.0.0.0", "224.0.0.251"} {
+		if _, err := newXDialFixedDNSConfig([]string{raw}); err == nil {
+			t.Fatalf("invalid resolver %q was accepted", raw)
+		}
+	}
+	if config, err := newXDialFixedDNSConfig(nil); err != nil || config != nil {
+		t.Fatalf("empty list must leave the transport unpinned: %v %v", config, err)
+	}
+}

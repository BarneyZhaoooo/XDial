+package socks
+
+import (
+	"bytes"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing/common/buf"
+	"github.com/sagernet/sing/common/bufio"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+)
+
+// SOCKS5 UDP ASSOCIATE gives the server no per-association metadata: the
+// sing server discards the request address and hands the destination of the
+// first datagram to the handler. The XDial loopback relay therefore opens a
+// bound association with one placeholder marker datagram whose destination is the
+// bound-interface envelope. The handler reads the interface from that first
+// destination (applyXDialFlowMetadata) and this filter keeps every marker out
+// of routing, so DNS forwarding and Direct dialing see the interface macOS
+// bound the application socket to. The association destination then becomes
+// the first real datagram's destination, exactly as without the marker.
+func isXDialBoundAssociationMarker(destination M.Socksaddr) bool {
+	return destination.IsDomain() &&
+		bytes.HasPrefix([]byte(destination.Fqdn), xdialBoundFlowMetadataMagic)
+}
+
+type xdialBoundMarkerFilterConn struct {
+	N.PacketConn
+}
+
+func newXDialBoundMarkerFilterConn(conn N.PacketConn) N.PacketConn {
+	return &xdialBoundMarkerFilterConn{PacketConn: conn}
+}
+
+func (c *xdialBoundMarkerFilterConn) ReadPacket(buffer *buf.Buffer) (M.Socksaddr, error) {
+	for {
+		destination, err := c.PacketConn.ReadPacket(buffer)
+		if err != nil || !isXDialBoundAssociationMarker(destination) {
+			return destination, err
+		}
+		buffer.Reset()
+	}
+}
+
+// xdialAdoptBoundAssociation runs after applyXDialFlowMetadata consumed the
+// marker destination. It reads past every marker to the first real datagram,
+// restores that datagram as the association destination and keeps it cached
+// for routing and sniffing.
+func xdialAdoptBoundAssociation(conn N.PacketConn, metadata *adapter.InboundContext) (N.PacketConn, error) {
+	filtered := newXDialBoundMarkerFilterConn(conn)
+	packet := buf.NewPacket()
+	destination, err := filtered.ReadPacket(packet)
+	if err != nil {
+		packet.Release()
+		return conn, err
+	}
+	metadata.Destination = destination
+	return bufio.NewCachedPacketConn(filtered, packet, destination), nil
+}
